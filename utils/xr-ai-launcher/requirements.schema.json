{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvidia.github.io/xr-ai/schemas/requirements.schema.json",
  "title": "xr-ai launcher dependency contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "os": {
      "$ref": "#/$defs/stringOrStrings"
    },
    "arch": {
      "oneOf": [
        {
          "$ref": "#/$defs/stringOrStrings"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed"
          ],
          "not": {
            "required": [
              "unless_env_present",
              "unless_env_truthy"
            ]
          },
          "properties": {
            "allowed": {
              "$ref": "#/$defs/stringOrStrings"
            },
            "unless_env_truthy": {
              "type": "string",
              "minLength": 1
            },
            "unless_env_present": {
              "type": "string",
              "minLength": 1
            },
            "unless_config": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "python": {
      "$ref": "#/$defs/versionRequirement"
    },
    "nvidia_driver": {
      "$ref": "#/$defs/versionRequirement"
    },
    "cuda": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/version"
        }
      ]
    },
    "docker": {
      "$ref": "#/$defs/versionRequirement"
    },
    "nvidia_container_toolkit": {
      "type": "boolean"
    },
    "vulkan": {
      "type": "boolean"
    },
    "nvenc": {
      "type": "boolean"
    },
    "node": {
      "$ref": "#/$defs/versionRequirement"
    },
    "disk_gb_free": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_keys",
        "runtime_gb"
      ],
      "properties": {
        "config_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runtime_gb": {
          "type": "number",
          "minimum": 0
        },
        "preparation": {
          "type": "boolean"
        }
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "port"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "proto": {
            "enum": [
              "tcp",
              "udp"
            ]
          },
          "health": {
            "type": "string",
            "minLength": 1
          },
          "config_key": {
            "type": "string",
            "minLength": 1
          },
          "enabled_config_key": {
            "type": "string",
            "minLength": 1
          },
          "unless_env_truthy": {
            "type": "string",
            "minLength": 1
          },
          "bind_host": {
            "type": "string",
            "minLength": 1
          },
          "bind_config_key": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "docs": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "unless_env_truthy": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "stringOrStrings": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "versionRequirement": {
      "oneOf": [
        {
          "$ref": "#/$defs/version"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "$ref": "#/$defs/version"
            },
            "unless_env_truthy": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
