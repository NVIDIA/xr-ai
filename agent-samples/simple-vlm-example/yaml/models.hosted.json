{
  "models": {
    "stt": {
      "adapter": {"preset": "parakeet_stt"},
      "endpoint": {"base_url": "http://localhost:8103", "readiness": "health"},
      "deployment": {"ownership": "managed", "service": "stt"}
    },
    "vlm": {
      "category": "vlm",
      "adapter": {
        "kind": "openai_compat",
        "model_name": "nvidia/cosmos3-nano-reasoner",
        "capabilities": {"streaming": true, "vision": true}
      },
      "endpoint": {
        "base_url": "https://integrate.api.nvidia.com",
        "api_key_env": "NGC_API_KEY",
        "readiness": "none"
      },
      "deployment": {"ownership": "external"}
    },
    "tts": {
      "adapter": {"preset": "piper_tts"},
      "endpoint": {"base_url": "http://localhost:8105", "readiness": "health"},
      "deployment": {"ownership": "managed", "service": "tts"}
    }
  }
}
