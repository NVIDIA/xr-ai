{
  "models": {
    "agent_llm": {
      "adapter": {
        "preset": "nemotron_omni",
        "default_extras": {"chat_template_kwargs": {"enable_thinking": false}}
      },
      "endpoint": {"base_url": "http://localhost:8108", "readiness": "health"},
      "deployment": {"ownership": "reused", "service": "omni"}
    },
    "vlm": {
      "category": "vlm",
      "adapter": {
        "kind": "openai_compat",
        "model_name": "llm",
        "capabilities": {"streaming": true, "vision": true},
        "default_extras": {
          "max_tokens": 128,
          "temperature": 0.0,
          "chat_template_kwargs": {"enable_thinking": false}
        }
      },
      "endpoint": {"base_url": "http://localhost:8108", "readiness": "health"},
      "deployment": {"ownership": "reused", "service": "omni"}
    },
    "stt": {
      "adapter": {"preset": "parakeet_stt"},
      "endpoint": {"base_url": "http://localhost:8103", "readiness": "health"},
      "deployment": {"ownership": "reused", "service": "stt"}
    },
    "embedding": {
      "adapter": {"preset": "nemotron_embedding"},
      "endpoint": {"base_url": "http://localhost:8109", "readiness": "health"},
      "deployment": {"ownership": "reused", "service": "embedding"}
    },
    "tts": {
      "adapter": {"preset": "piper_tts"},
      "endpoint": {"base_url": "http://localhost:8105", "readiness": "health"},
      "deployment": {"ownership": "managed", "service": "tts"}
    }
  }
