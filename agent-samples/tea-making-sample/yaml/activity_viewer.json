{
  "host": "0.0.0.0",
  "port": 8092,
  "poll_interval_s": 0.25,
  "sources": [
    {
      "id": "transcript",
      "title": "Transcript recorder",
      "directory": "../artifacts/transcripts"
    },
    {
      "id": "video_log",
      "title": "Video activity logger",
      "directory": "../artifacts/video-logs"
    },
    {
      "id": "agent",
      "title": "Agent activity",
      "path": "worker.log",
      "format": "event_log",
      "include_prefixes": [
        "agent.",
        "application_manager.",
        "rag.",
        "step.",
        "trigger.",
        "voice.",
        "workflow."
      ],
      "exclude_events": [
        "step.commit_noop"
      ]
    },
    {
      "id": "change_watch",
      "title": "Visual change watcher",
      "directory": "../artifacts/change-watch"
    }
  ]
}
